# Anthropic API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override (default: claude-opus-5)
# LISTFLOW_MODEL=claude-opus-5

# --- Google Sheets (opsiyonel) ---
# Servis hesabi olusturun, JSON key indirin, sheet'i servis hesabinin
# e-postasi ile "Viewer" olarak paylasin.
GOOGLE_SERVICE_ACCOUNT_EMAIL=listflow@your-project.iam.gserviceaccount.com
# Private key'i tek satirda, \n kacis karakterleriyle yapistirin.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Varsayilan sheet (UI'dan da girilebilir)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:B
