# OpenAI API — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Opsiyonel: model. Vision + strict JSON schema destekleyen herhangi bir model.
# Varsayilan gpt-5.4. Toplu is icin gpt-5.4-mini (daha hizli/ucuz).
# OPENAI_MODEL=gpt-5.4

# --- Google Sheets (opsiyonel) ---
# Servis hesabi olusturun, JSON key indirin, sheet'i servis hesabinin
# e-postasi ile "Viewer" olarak paylasin.
GOOGLE_SERVICE_ACCOUNT_EMAIL=listflow@your-project.iam.gserviceaccount.com
# Private key'i tek satirda, \n kacis karakterleriyle yapistirin.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# Varsayilan sheet (UI'dan da girilebilir)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Sheet1!A:B

# --- Etsy Open API v3 (opsiyonel) ---
# https://www.etsy.com/developers/your-apps -> app'in "Keystring" degeri.
# Etsy app ayarlarinda Callback URL olarak asagidaki adresi ekleyin.
ETSY_KEYSTRING=
ETSY_REDIRECT_URI=http://localhost:3000/api/etsy/callback
